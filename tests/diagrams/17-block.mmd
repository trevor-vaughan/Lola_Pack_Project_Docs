block-beta
  columns 3
  doc["client"]:3
  block:edge:3
    columns 3
    lb["load balancer"]
    cdn["cdn"]
    waf["waf"]
  end
  block:svc:3
    columns 3
    api["api gateway"]
    auth["auth"]
    rate["rate limit"]
  end
  block:core:3
    columns 3
    block:logic:1
      columns 1
      svc1["bookings"]
      svc2["catalog"]
      svc3["payments"]
    end
    block:queue:1
      columns 1
      q1["events"]
      q2["jobs"]
    end
    block:data:1
      columns 1
      db1["postgres"]
      db2["redis"]
      db3["s3"]
    end
  end

  doc --> lb
  lb --> api
  api --> auth
  auth --> svc1
  svc1 --> q1
  svc1 --> db1

