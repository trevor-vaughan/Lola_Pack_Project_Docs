architecture-beta
  group api(cloud)[API tier]
  group data(database)[Data tier]
  group async(server)[Async tier]

  service gateway(internet)[Gateway] in api
  service auth(server)[Auth] in api
  service bookings(server)[Bookings] in api

  service primary(database)[Primary DB] in data
  service replica(database)[Replica DB] in data
  service cache(database)[Redis] in data

  service queue(server)[Queue] in async
  service worker(server)[Worker] in async
  service mailer(server)[Mailer] in async

  gateway:R --> L:auth
  gateway:B --> T:bookings
  auth:R --> L:primary
  bookings:R --> L:primary
  primary:R --> L:replica
  bookings:B --> T:cache
  bookings:R --> L:queue
  queue:R --> L:worker
  worker:R --> L:mailer
  worker:T --> B:primary
