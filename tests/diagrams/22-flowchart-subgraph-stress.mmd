flowchart LR
  subgraph clients["clients"]
    direction TB
    web["web SPA"]
    mobile["mobile app"]
    cli["cli tool"]
  end

  subgraph edge["edge layer"]
    direction TB
    cdn["cdn"]
    waf["waf"]
    subgraph gw["api gateway"]
      direction TB
      routing["routing"]
      authz["authz"]
      ratelim["rate limit"]
    end
  end

  subgraph platform["platform"]
    direction TB
    subgraph identity["identity"]
      direction LR
      idp["idp"]
      sessions["sessions"]
      mfa["mfa"]
    end
    subgraph commerce["commerce"]
      direction LR
      catalog["catalog"]
      cart["cart"]
      orders["orders"]
      payments["payments"]
    end
    subgraph contentplane["content"]
      direction LR
      cms["cms"]
      search["search"]
      recs["recs"]
    end
  end

  subgraph dataplane["data plane"]
    direction TB
    subgraph oltp["oltp"]
      pg["postgres"]
      mysql["mysql"]
    end
    subgraph olap["olap"]
      warehouse["warehouse"]
      lake["lake"]
    end
    subgraph caches["caches"]
      redis["redis"]
      memcached["memcached"]
    end
  end

