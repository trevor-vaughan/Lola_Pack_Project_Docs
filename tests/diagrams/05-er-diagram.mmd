erDiagram
  CUSTOMER ||--o{ ORDER : places
  CUSTOMER ||--|{ ADDRESS : ships_to
  CUSTOMER {
    uuid id PK
    string email UK
    string name
    timestamp created_at
  }
  ORDER ||--|{ LINE_ITEM : contains
  ORDER ||--|| PAYMENT : paid_by
  ORDER ||--o{ SHIPMENT : split_into
  ORDER {
    uuid id PK
    uuid customer_id FK
    decimal total
    string status
  }
  LINE_ITEM }o--|| PRODUCT : refers_to
  LINE_ITEM {
    uuid id PK
    uuid order_id FK
    uuid product_id FK
    int quantity
    decimal unit_price
  }
  PRODUCT ||--o{ INVENTORY : tracked_in
  PRODUCT ||--o{ REVIEW : has
  PRODUCT {
    uuid id PK
    string sku UK
    string name
    decimal price
  }
  INVENTORY }o--|| WAREHOUSE : stored_at
  INVENTORY {
    uuid product_id FK
    uuid warehouse_id FK
    int on_hand
    int reserved
  }
  WAREHOUSE ||--o{ SHIPMENT : dispatches
  WAREHOUSE {
    uuid id PK
    string code UK
    string region
  }
  SHIPMENT ||--|| CARRIER : via
  SHIPMENT {
    uuid id PK
    uuid order_id FK
    uuid carrier_id FK
    string tracking_number
  }
  CARRIER {
    uuid id PK
    string name
    string api_endpoint
  }
  REVIEW }o--|| CUSTOMER : written_by
  REVIEW {
    uuid id PK
    uuid product_id FK
    uuid customer_id FK
    int rating
    text body
  }
  PAYMENT {
    uuid id PK
    uuid order_id FK
    decimal amount
    string method
  }
  ADDRESS {
    uuid id PK
    uuid customer_id FK
    string line1
    string city
    string postal_code
    string country
  }
